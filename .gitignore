# A whitelist: the working tree also holds gigabytes of downloads, build output, logs, third-party
# clones and files of iOS, none of which belongs in the repository. Nothing is tracked unless it
# is named here.
/*
!/.gitignore
!/README.md
!/CONTRIBUTING.md
!/ci/
!/README.uk.md
!/README.zh.md
!/Makefile
!/LICENSE
!/LICENSE.APSL
!/NOTICE
!/LEGAL.md
!/COMPLIANCE.md
!/THIRD_PARTY_LICENSES.md
!/devices/
!/docs/
!/xl
!/mkxnuimg.py
!/xnu-build.sh
!/xnu-env.sh
!/xnuloader/
!/mtkshim/
!/qemu/
!/tools/pac-emu/
!/tools/
!/userland/
!/sysimage/
!/xnu/
!/xnu-deps/
!/prebuilt/
!/wifi/

# vendor firmware pulled from a phone: MediaTek's and Xiaomi's, never redistributed
/fw-mtk-*/
/fw-*/

# build output of the device scripts: the boot image, the payload, the pulled tree, the SoC values
/devices/*/boot.img
/devices/*/mtk.dtb
/devices/*/mtk.args
/devices/*/soc.args

__pycache__/
*~
*.orig
*.rej

/xnuloader/*
!/xnuloader/build.sh
!/xnuloader/efi.h
!/xnuloader/loader.c
!/xnuloader/mkidentity.py
!/xnuloader/mkpayload.py

/qemu/*
!/qemu/*.sh
!/qemu/*.py

# the MediaTek shim: sources only; font5x7.h is generated by mkfont.py, the rest is build output
/mtkshim/*
!/mtkshim/*.c
!/mtkshim/*.h
!/mtkshim/*.S
!/mtkshim/*.ld
!/mtkshim/*.sh
!/mtkshim/*.py
/mtkshim/font5x7.h

/userland/*
!/userland/build.sh
!/userland/*.py
!/userland/rc.*
!/userland/com.hakios.*.plist
!/userland/src/
!/userland/libmini/
!/userland/var/

/sysimage/*
!/sysimage/fetch.sh
!/sysimage/*.py

# of xnu-deps only what is ours; setup.sh fetches and builds the rest
/xnu-deps/*
!/xnu-deps/setup.sh
!/xnu-deps/gen-iig-stubs.py
!/xnu-deps/hostinc/
!/xnu-deps/iig-impl/
!/xnu-deps/host/
/xnu-deps/host/*
!/xnu-deps/host/bin/
/xnu-deps/host/bin/*
!/xnu-deps/host/bin/codesign
!/xnu-deps/host/bin/iig
!/xnu-deps/host/bin/install
!/xnu-deps/host/bin/plutil
!/xnu-deps/host/bin/sw_vers
!/xnu-deps/host/bin/xcrun
!/xnu-deps/host/bin/xnu-clang
!/xnu-deps/build/
/xnu-deps/build/*
!/xnu-deps/build/pthread/
/xnu-deps/build/pthread/*
!/xnu-deps/build/pthread/build.sh
!/xnu-deps/build/pthread/inc/
!/xnu-deps/build/lzbitmap/
/xnu-deps/build/lzbitmap/*
!/xnu-deps/build/lzbitmap/unzbm.c
!/xnu-deps/build/lzbitmap/libzbitmap.c
!/xnu-deps/build/lzbitmap/libzbitmap.h
/tools/android/f2fs-resize
/tools/macos-bin/platform-tools/

# made at build time from the device tree of the builder's own IPSW (xnuloader/mkidentity.sh)
/xnuloader/identity.h
!/xnuloader/im4p.py
!/xnuloader/mkidentity.sh

/tools/pac-emu/test_pac_emu
/tools/pac-emu/pac_decoder.h

# a release signing key is never in the tree: a private key in a public repository is an invitation
# to forge releases. tools/release.py keygen makes one locally; the public half is published.
/release.key
/release.key.enc
release.key
*.pem
release.pem
/tools/*.key
/tools/*.pem

# a manifest describes one build; the published one lives in the channel, not here
/release.json
/release.json.sig

# build output of the shim and the boot image
/mtkshim/*.o
/mtkshim/shim.elf
/mtkshim/shim.bin
/mtkshim/font5x7.h
/mtkshim/test-payload.bin
/mtkshim/payload.bin
/devices/redmi-14c/boot.img

!release.pub
